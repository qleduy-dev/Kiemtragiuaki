@model IEnumerable<Kiemtragiuaki.Models.Enrollment>

@{
    ViewData["Title"] = "Khóa Học Của Tôi";
}

<div class="container-fluid py-4" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-12">
                <h1 class="fw-bold mb-2">
                    <i class="fas fa-graduation-cap me-2" style="color: #667eea;"></i>Khóa Học Của Tôi
                </h1>
                <p class="text-muted">Xem và quản lý các khóa học bạn đã đăng ký</p>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>
                            <i class="fas fa-book me-2"></i>Tên Khóa Học
                        </th>
                        <th>
                            <i class="fas fa-tag me-2"></i>Danh Mục
                        </th>
                        <th>
                            <i class="fas fa-chalkboard-user me-2"></i>Giáo Viên
                        </th>
                        <th>
                            <i class="fas fa-coins me-2"></i>Tín Chỉ
                        </th>
                        <th>
                            <i class="fas fa-calendar me-2"></i>Ngày Đăng Ký
                        </th>
                        <th class="text-center">
                            <i class="fas fa-cogs me-2"></i>Hành Động
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in Model)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("Details", "Courses", new { id = enrollment.CourseId })" class="fw-bold text-primary">
                                    @enrollment.Course?.Name
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-info">@enrollment.Course?.Category?.Name</span>
                            </td>
                            <td>@enrollment.Course?.Lecturer</td>
                            <td>
                                <span class="badge bg-warning text-dark">@enrollment.Course?.Credit</span>
                            </td>
                            <td>@enrollment.EnrollDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <form method="post" asp-controller="Enrollments" asp-action="Unenroll" style="display: inline;">
                                    <input type="hidden" name="enrollmentId" value="@enrollment.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" 
                                            onclick="return confirm('Bạn có chắc chắn muốn hủy đăng ký khóa học này?');">
                                        <i class="fas fa-times me-1"></i>Hủy Đăng Ký
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row mt-5">
            <div class="col-md-12">
                <a href="@Url.Action("Index", "Courses")" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus me-2"></i>Duyệt Thêm Khóa Học
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5" role="alert">
            <i class="fas fa-info-circle fa-2x mb-3"></i>
            <p class="mb-2">
                <strong>Bạn chưa đăng ký khóa học nào.</strong>
            </p>
            <p class="mb-3">
                <a href="@Url.Action("Index", "Courses")">Duyệt các khóa học có sẵn</a> để tìm và đăng ký.
            </p>
        </div>
    }
</div>

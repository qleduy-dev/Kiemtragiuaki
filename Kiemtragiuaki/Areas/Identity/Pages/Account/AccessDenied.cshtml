@page "/Identity/Account/AccessDenied"
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-5">
                    <i class="fas fa-ban fa-4x text-danger mb-3"></i>
                    <h2 class="fw-bold mb-3">Không có quyền truy cập</h2>
                    <p class="text-muted mb-4">Tài khoản của bạn không được phép thực hiện chức năng này.</p>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i>Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

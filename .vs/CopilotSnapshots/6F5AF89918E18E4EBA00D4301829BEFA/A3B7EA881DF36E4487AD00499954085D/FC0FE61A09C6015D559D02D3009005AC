@model Kiemtragiuaki.Models.Course

@{
    ViewData["Title"] = Model.Name;
    var isEnrolled = Model.Enrollments?.Any(e => e.User?.UserName == User.Identity?.Name) ?? false;
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="mb-4">
                <a href="@Url.Action("Index", "Courses")" class="btn btn-outline-secondary mb-3">
                    <i class="fas fa-arrow-left me-2"></i>Quay Lại
                </a>
                <h1 class="fw-bold">@Model.Name</h1>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="~/images/@Model.Image" class="card-img-top" style="height: 300px; object-fit: cover;" alt="@Model.Name" />
                }
                else
                {
                    <div style="height: 300px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-book fa-5x text-white opacity-50"></i>
                    </div>
                }
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Thông Tin Khóa Học
                    </h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <td width="30%"><strong><i class="fas fa-chalkboard-user me-2"></i>Giáo Viên:</strong></td>
                            <td>@Model.Lecturer</td>
                        </tr>
                        <tr>
                            <td><strong><i class="fas fa-coins me-2"></i>Tín Chỉ:</strong></td>
                            <td><span class="badge bg-warning text-dark">@Model.Credit</span></td>
                        </tr>
                        <tr>
                            <td><strong><i class="fas fa-tag me-2"></i>Danh Mục:</strong></td>
                            <td>@Model.Category?.Name</td>
                        </tr>
                        <tr>
                            <td><strong><i class="fas fa-users me-2"></i>Sinh Viên Đã Đăng Ký:</strong></td>
                            <td>
                                <span class="badge bg-info">@(Model.Enrollments?.Count ?? 0)</span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-graduation-cap me-2"></i>Đăng Ký
                    </h5>
                </div>
                <div class="card-body">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        @if (isEnrolled)
                        {
                            <div class="alert alert-success" role="alert">
                                <i class="fas fa-check-circle me-2"></i>
                                <strong>Bạn đã đăng ký khóa học này</strong>
                            </div>
                            <a href="@Url.Action("MyCourses", "Enrollments")" class="btn btn-primary w-100">
                                <i class="fas fa-list me-2"></i>Xem Các Khóa Học Của Tôi
                            </a>
                        }
                        else
                        {
                            <p class="text-muted mb-3">
                                <i class="fas fa-lightbulb me-2"></i>
                                Bạn quan tâm đến khóa học này? Hãy nhấp nút dưới để đăng ký ngay.
                            </p>
                            <form method="post" asp-controller="Enrollments" asp-action="Enroll">
                                <input type="hidden" name="courseId" value="@Model.Id" />
                                <button type="submit" class="btn btn-success w-100 btn-lg">
                                    <i class="fas fa-check me-2"></i>Đăng Ký Ngay
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-3">
                            <i class="fas fa-lock me-2"></i>
                            Bạn phải đăng nhập để đăng ký khóa học.
                        </p>
                        <a href="~/Identity/Account/Login" class="btn btn-primary w-100 btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>Đăng Nhập
                        </a>
                    }
                </div>
            </div>

            @if (User.IsInRole("ADMIN"))
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">
                            <i class="fas fa-cogs me-2"></i>Hành Động Quản Trị
                        </h5>
                    </div>
                    <div class="card-body">
                        <a href="@Url.Action("Edit", "Courses", new { id = Model.Id })" class="btn btn-warning w-100 mb-2">
                            <i class="fas fa-edit me-2"></i>Chỉnh Sửa
                        </a>
                        <a href="@Url.Action("Delete", "Courses", new { id = Model.Id })" class="btn btn-danger w-100">
                            <i class="fas fa-trash me-2"></i>Xóa Khóa Học
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@model Kiemtragiuaki.Models.Course

@{
    ViewData["Title"] = "Xóa Học Phần";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0"><i class="fas fa-trash me-2"></i>@ViewData["Title"]</h3>
                </div>
                <div class="card-body p-4">
                    @if (Model.Enrollments.Any())
                    {
                        <div class="alert alert-danger">
                            <strong>Không nên xóa!</strong> Học phần này đã có @Model.Enrollments.Count sinh viên đăng ký. Hệ thống sẽ chặn xóa để tránh mất dữ liệu đăng ký.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Bạn sắp xóa học phần này. Thao tác này không thể hoàn tác.
                        </div>
                    }

                    <h5 class="fw-bold mb-3">@Model.Name</h5>
                    <table class="table table-borderless">
                        <tr><td width="30%"><strong>Giảng viên:</strong></td><td>@Model.Lecturer</td></tr>
                        <tr><td><strong>Số tín chỉ:</strong></td><td>@Model.Credit</td></tr>
                        <tr><td><strong>Danh mục:</strong></td><td>@Model.Category?.Name</td></tr>
                        <tr><td><strong>Số đăng ký:</strong></td><td>@Model.Enrollments.Count</td></tr>
                    </table>

                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger" @(Model.Enrollments.Any() ? "disabled" : "")>
                            <i class="fas fa-trash me-2"></i>Xác nhận xóa
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

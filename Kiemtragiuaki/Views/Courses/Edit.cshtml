@model Kiemtragiuaki.Models.Course

@{
    ViewData["Title"] = "Cập Nhật Học Phần";
    var categories = ViewData["Categories"] as List<Kiemtragiuaki.Models.Category> ?? new List<Kiemtragiuaki.Models.Category>();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>@ViewData["Title"]</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Tên học phần *</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Credit" class="form-label fw-bold">Số tín chỉ *</label>
                            <input asp-for="Credit" type="number" min="1" max="10" class="form-control" />
                            <span asp-validation-for="Credit" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Lecturer" class="form-label fw-bold">Giảng viên *</label>
                            <input asp-for="Lecturer" class="form-control" />
                            <span asp-validation-for="Lecturer" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Image" class="form-label fw-bold">Tên file hình ảnh</label>
                            <input asp-for="Image" class="form-control" />
                            <span asp-validation-for="Image" class="text-danger"></span>
                            <small class="text-muted">Đặt ảnh trong thư mục <code>wwwroot/images</code>. Chỉ nhập tên file.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">Danh mục *</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-2"></i>Lưu thay đổi
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

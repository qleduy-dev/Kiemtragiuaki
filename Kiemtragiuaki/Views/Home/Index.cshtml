@model IEnumerable<Kiemtragiuaki.Models.Course>

@{
    ViewData["Title"] = "Trang Chủ";
    var courseCount = ViewData["CourseCount"] is int cc ? cc : Model.Count();
    var enrollmentCount = ViewData["EnrollmentCount"] is int ec ? ec : 0;
    var categoryCount = ViewData["CategoryCount"] is int catc ? catc : 0;
}

<div class="container-fluid py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-4">
                    <i class="fas fa-graduation-cap me-3"></i>Hệ Thống Đăng Ký Học Phần
                </h1>
                <p class="lead mb-4">Khám phá, đăng ký và quản lý học phần một cách rõ ràng, nhanh chóng.</p>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <p class="mb-3"><i class="fas fa-user-check me-2"></i><strong>Xin chào, @User.Identity.Name!</strong></p>
                    @if (User.IsInRole("STUDENT"))
                    {
                        <a class="btn btn-light btn-lg me-2" asp-controller="Courses" asp-action="Index"><i class="fas fa-book me-2"></i>Duyệt học phần</a>
                        <a class="btn btn-outline-light btn-lg" asp-controller="Enrollments" asp-action="MyCourses"><i class="fas fa-list me-2"></i>Học phần của tôi</a>
                    }
                    @if (User.IsInRole("ADMIN"))
                    {
                        <a class="btn btn-light btn-lg me-2" asp-controller="Courses" asp-action="Index"><i class="fas fa-cogs me-2"></i>Quản lý học phần</a>
                        <a class="btn btn-outline-light btn-lg" asp-controller="Courses" asp-action="Create"><i class="fas fa-plus me-2"></i>Thêm học phần</a>
                    }
                }
                else
                {
                    <p class="mb-4">Đăng nhập hoặc tạo tài khoản sinh viên để bắt đầu đăng ký học phần.</p>
                    <a class="btn btn-light btn-lg me-2" asp-area="Identity" asp-page="/Account/Register"><i class="fas fa-user-plus me-2"></i>Đăng ký ngay</a>
                    <a class="btn btn-outline-light btn-lg" asp-area="Identity" asp-page="/Account/Login"><i class="fas fa-sign-in-alt me-2"></i>Đăng nhập</a>
                }
            </div>
            <div class="col-lg-4 text-center">
                <i class="fas fa-books display-1"></i>
            </div>
        </div>
    </div>
</div>

<div class="bg-light py-5">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <h3 class="fw-bold" style="color: #667eea;"><i class="fas fa-book me-2"></i>@courseCount</h3>
                <p class="text-muted mb-0">Học phần hiện có</p>
            </div>
            <div class="col-md-4 mb-4">
                <h3 class="fw-bold" style="color: #667eea;"><i class="fas fa-layer-group me-2"></i>@categoryCount</h3>
                <p class="text-muted mb-0">Danh mục</p>
            </div>
            <div class="col-md-4 mb-4">
                <h3 class="fw-bold" style="color: #667eea;"><i class="fas fa-user-check me-2"></i>@enrollmentCount</h3>
                <p class="text-muted mb-0">Lượt đăng ký</p>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-star me-2" style="color:#667eea"></i>Danh sách học phần</h2>
            <p class="text-muted mb-0">Trang chủ hiển thị toàn bộ học phần theo đúng nghiệp vụ đề bài.</p>
        </div>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary"><i class="fas fa-search me-2"></i>Tìm kiếm</a>
    </div>

    <div class="row">
        @if (Model.Any())
        {
            @foreach (var course in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 course-card">
                        <div class="position-relative" style="height: 190px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            @if (!string.IsNullOrEmpty(course.Image))
                            {
                                <img src="~/images/@course.Image" class="w-100 h-100" style="object-fit: cover;" alt="@course.Name" />
                            }
                            else
                            {
                                <div class="d-flex h-100 align-items-center justify-content-center"><i class="fas fa-book fa-4x text-white opacity-50"></i></div>
                            }
                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3">@course.Credit tín chỉ</span>
                        </div>
                        <div class="card-body">
                            <h5 class="fw-bold">@course.Name</h5>
                            <p class="small text-muted mb-2"><i class="fas fa-chalkboard-user me-2"></i>@course.Lecturer</p>
                            <p class="small text-muted mb-2"><i class="fas fa-tag me-2"></i>@course.Category?.Name</p>
                            <p class="small text-muted"><i class="fas fa-users me-2"></i>@course.Enrollments.Count sinh viên</p>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0">
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="btn btn-primary w-100">
                                <i class="fas fa-eye me-2"></i>Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center py-4">Chưa có học phần nào trong hệ thống.</div>
            </div>
        }
    </div>
</div>

<style>
    .course-card { transition: transform .25s ease, box-shadow .25s ease; overflow: hidden; }
    .course-card:hover { transform: translateY(-6px); box-shadow: 0 12px 24px rgba(0,0,0,.15) !important; }
</style>

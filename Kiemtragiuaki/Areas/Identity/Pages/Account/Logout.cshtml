@page
@model Kiemtragiuaki.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="display-6 text-primary mb-3">
                        <i class="fas fa-sign-out-alt"></i>
                    </div>
                    <h2 class="h4 mb-2">Đăng xuất</h2>
                    <p class="text-muted mb-4">Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?</p>
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-sign-out-alt me-1"></i>Đăng xuất
                        </button>
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">
                            Hủy
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
